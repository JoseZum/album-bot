{
  "name": "album-bot",
  "version": "1.0.0",
  "description": "Backend simple para album-bot",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "postinstall": "npm run build",
    "db:migrate": "psql $DATABASE_URL -f db/01-schema.sql -f db/02-seed-album-data.sql -f db/03-trade-offers.sql -f db/04-drop-sticker-fks.sql -f db/05-friends.sql",
    "test": "node --test --test-concurrency=1 --import tsx \"tests/**/*.test.ts\"",
    "test:unit": "node --test --test-concurrency=1 --import tsx \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 --import tsx \"tests/integration/**/*.test.ts\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "express": "^4.21.2",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
